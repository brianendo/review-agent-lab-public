diff --git a/stats.py b/stats.py
--- a/stats.py
+++ b/stats.py
@@ -1 +1,29 @@
 """Summary statistics over lists of numbers."""
+
+
+def mean(xs):
+    """Arithmetic mean."""
+    return sum(xs) / len(xs)
+
+
+def median(xs):
+    """Middle value; for even length, the average of the two middle values."""
+    s = sorted(xs)
+    n = len(s)
+    return s[n // 2]
+
+
+def sample_range(xs):
+    """Difference between the largest and smallest value."""
+    return max(xs) - min(xs)
+
+
+def percentile(xs, p):
+    """The p-th percentile (p in 0..100), nearest-rank."""
+    s = sorted(xs)
+    return s[int(len(s) * p / 100)]
+
+
+def moving_average(xs, k):
+    """List of k-window moving averages."""
+    return [sum(xs[i:i + k]) / k for i in range(len(xs) - k)]

