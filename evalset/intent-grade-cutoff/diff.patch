diff --git a/grades.py b/grades.py
--- a/grades.py
+++ b/grades.py
@@ -1 +1,12 @@
 """Letter grades."""
+
+
+def letter_grade(score):
+    """Map a 0-100 score to a letter grade."""
+    if score >= 90:
+        return "A"
+    if score >= 80:
+        return "B"
+    if score >= 70:
+        return "C"
+    return "F"

